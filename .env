DB_NAME=squid
DB_PORT=23798
GQL_PORT=4350

# JSON-RPC node endpoints (wss or https)
# Use private endpoints in production! If deploying to Cloud:
# - use our RPC proxy service: https://docs.sqd.dev/en/cloud/resources/rpc-proxy, OR
# - save your private url as a secret: https://docs.sqd.dev/en/cloud/resources/env-variables
RPC_KUSAMA_HTTP=https://kusama-rpc.polkadot.io

# Uncommenting this line enables the debug mode
# More info at https://docs.sqd.dev/en/sdk/squid-sdk/substrate/reference/logger
#SQD_DEBUG=*

# SQD Network API key for v2 gateway access when self-hosting.
# Create one at https://portal.sqd.dev/app  (see https://docs.sqd.dev/en/data/api-keys)
#SQD_API_KEY=
